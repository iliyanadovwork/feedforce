# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# --- AI services ---
GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash-lite   # optional: default model for the BUFFERED/batch callers (news
                            # summaries, etc.). Allow-listed to gemini-2.5-flash (default),
                            # gemini-2.5-flash-lite (cheapest), gemini-2.5-pro. flash-lite is ~6x cheaper on
                            # output — good for the large batch outputs.
# COPILOT_MODEL=gemini-2.5-flash   # optional: model for the INTERACTIVE copilots (editor + reels), which
                            # stream structured JSON. Defaults to flash and does NOT follow GEMINI_MODEL,
                            # because flash-lite intermittently drops the stream (~25% on multi-action asks
                            # → "unreadable response"). The copilot's output is tiny (~$0.001/call), so the
                            # reliability is worth it. Only lower this if a future run proves a cheaper tier stable.
# --- MiMo (Xiaomi) via an OpenAI-compatible gateway — OPTIONAL, for A/B-ing against Gemini ---
# The LLM funnel routes any allow-listed MiMo model id (xiaomi/mimo-v2.5, xiaomi/mimo-v2.5-pro) to this
# backend automatically. Set the key to turn it on, then point GEMINI_MODEL/COPILOT_MODEL (or a per-call
# model) at a MiMo id. Nothing uses MiMo until a key is present, so it's safe to leave unset.
# MIMO_API_KEY=...                                  # OpenRouter key (sk-or-...) or a mimo.mi.com key
# MIMO_BASE_URL=https://openrouter.ai/api/v1        # default OpenRouter; point at mimo.mi.com's OpenAI-compatible endpoint to switch
# MIMO_JSON_MODE=off                                # optional escape hatch: drop response_format:json_object if the model 400s on it (the prompt already demands JSON)
# OPENROUTER_API_KEY=sk-or-...                       # optional fallback used when MIMO_API_KEY is unset (same OpenAI-compatible gateway)
BRIA_API_TOKEN=...   # BRIA image expansion (Posts → Expand image); server-only, never NEXT_PUBLIC_

# --- Billing (Stripe + Lemon Squeezy) ---
# WHICH provider new checkouts use is a runtime toggle at /admin (default Stripe) — configure BOTH so
# existing subscribers keep billing on their original provider after a switch, until they churn.
# Stripe: https://dashboard.stripe.com/apikeys; webhook endpoint → /api/billing/stripe-webhook.
# Subscribe the endpoint to: customer.subscription.* (access), checkout.session.completed +
# invoice.payment_succeeded (affiliate referrals + commissions), charge.refunded +
# charge.dispute.created + charge.dispute.closed (commission reversal/reinstate). Missing events =
# those features silently no-op.
STRIPE_SECRET_KEY=...                    # sk_... (or a restricted rk_ key: Checkout/Customers/Subscriptions/Portal)
STRIPE_PRICE_ID=...                      # recurring Price id (price_...) of the subscription plan
STRIPE_WEBHOOK_SECRET=...                # whsec_... from the webhook endpoint
# PLAN_PRICE_USD=59.99                   # optional: plan price used for the /admin MRR calc (defaults to 59.99)
# Lemon Squeezy: https://docs.lemonsqueezy.com/ — Settings → API for the key; webhook → /api/billing/webhook.
LEMONSQUEEZY_API_KEY=...                 # server-only API key
LEMONSQUEEZY_STORE_ID=...                # numeric store id
LEMONSQUEEZY_VARIANT_ID=...              # default plan's variant id (the thing being subscribed to)
LEMONSQUEEZY_WEBHOOK_SECRET=...          # signing secret you set when creating the webhook
NEXT_PUBLIC_SITE_URL=http://localhost:3000  # origin used for the post-checkout redirect

# --- Discord notifications (optional) ---
# Signup / trial / cancellation / failed-payment alerts posted to a Discord channel. Create it in Discord:
# Server Settings → Integrations → Webhooks → New Webhook → pick the channel → Copy Webhook URL.
# Unset = notifications off (the app just skips them). Also subscribe the Stripe endpoint to
# invoice.payment_failed for the failed-payment alert.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# --- Admin ---
# Comma-separated account emails. ONE variable, used in two places: gates /admin (billing-provider
# switch, revenue, etc.) AND the in-app Support inbox (/api/support/inbox — see all user chats + reply).
# Server-only. Users can chat with support regardless; this only gates the admin inbox view.
ADMIN_EMAILS=you@example.com

# --- Automations ---
AUTOMATION_SECRET_KEY=...   # encrypts stored node credentials at rest (any long random string)
CRON_SECRET=...             # gates /api/cron/automations; Vercel Cron sends it as a Bearer token
# RENDER_ORIGIN=https://your-app.com      # optional: public origin the cron uses to render Post nodes when the deployment sits behind a different host
# CHROME_EXECUTABLE_PATH=/path/to/chrome  # DEV only: local Chrome for headless render (prod uses bundled @sparticuz/chromium)

# --- Zernio (social scheduling: Instagram, etc.) ---
# https://docs.zernio.com — create a key at https://zernio.com/dashboard/api-keys.
# Server-only (proxied through /api/schedule/*); NEVER expose as NEXT_PUBLIC. Format: sk_<64 hex>.
ZERNIO_API_KEY=...

# --- AI usage limits (optional; sensible defaults apply if unset) ---
# Gemini has NO rate caps here by design — the key runs on the paid tier (~1,000 RPM) and the ONLY
# Gemini limit is the per-user monthly credit below. Ledger: production/supabase/ai_usage.sql (run it
# once in the SQL editor).
AI_MONTHLY_BUDGET_USD=15    # per-user monthly AI credit in USD (token cost, all providers); resets on the 1st, no rollover.
# AI_DEBUG_USAGE=1          # DEV ONLY: log each AI call's model, tokens, and cost to the server console, tagged
                            # (reported) when the vendor gave the exact charge (OpenRouter's usage.cost) or
                            # (rate-est) when derived from the rate table. Lets you reconcile the ledger per call.
# AI_MOCK=1                 # DEV ONLY: short-circuit every Gemini call with canned, schema-valid responses so the
                            # copilot (carousel + reels) and element generator can be tested WITHOUT spending credits.
                            # No key needed, no budget spent. The copilot responds to keywords ("bigger", "darker",
                            # "center", "add a chart", "redesign") so edits actually apply. Auto-ignored when
                            # NODE_ENV=production, so it can't disable real AI/billing on a deploy even if set.
BRIA_DAILY_CAP=100          # app-wide BRIA image-expand calls per 24h
BRIA_USER_DAILY_CAP=20      # per-user BRIA image-expand calls per 24h, so one user can't drain the pool

# --- Feature flags ---
NEXT_PUBLIC_AUTOMATIONS_ENABLED=false   # Automations engine + Schedule. Keep false until production-ready (readiness audit). Toggling needs a redeploy.
# NEXT_PUBLIC_EXPAND_IMAGE_ENABLED=false  # BRIA "Expand image" (Posts → image card). Hidden + blocked unless 'true'. Runs on a shared paid key.
